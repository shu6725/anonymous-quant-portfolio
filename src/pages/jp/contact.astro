---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';

export const prerender = true;
---

<BaseLayout title="連絡先" description="選択したフリーランス・契約案件に関する連絡先。" locale="ja" pagePath="contact/">
  <section class="page-intro shell reading-width contact-page">
    <p class="eyebrow">連絡先</p>
    <h1>プロジェクトのご相談はこちらから。</h1>
    <p class="lead">定量リサーチ、トレーディングデータ分析、デリバティブ分析、デジタル資産リサーチ、小規模な金融ソフトウェアの試作について。</p>
    <ContactForm locale="ja" />
  </section>
</BaseLayout>
