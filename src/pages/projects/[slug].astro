---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { localizedPath } from '../../i18n';

export const prerender = true;

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<BaseLayout title={project.title} description={project.summary} locale="en" pagePath={'projects/' + project.slug + '/'}>
  <article class="project-page shell reading-width">
    <a class="back-link" href={localizedPath('en', 'projects/')}>← All projects</a>
    <header class="project-header">
      <p class="eyebrow">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="lead">{project.summary}</p>
      <ul class="tag-list" aria-label={`${project.title} topics`}>
        {project.topics.map((topic) => <li>{topic}</li>)}
      </ul>
    </header>
    <section class="demo-placeholder" aria-label="Project demonstration placeholder">
      <p class="eyebrow">Demo / visualization</p>
      <div class="demo-graphic" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <p>{project.demoLabel}</p>
    </section>
    <div class="project-sections">
      {project.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
        </section>
      ))}
    </div>
    <section class="project-links">
      <h2>Code / repository</h2>
      <p>Repository link intentionally not configured. Add only a public repository that has been reviewed for confidentiality and identifying metadata.</p>
    </section>
    <section class="project-links">
      <h2>Related research</h2>
      <p>Related independent research can be linked here when published.</p>
      <a class="text-link" href={localizedPath('en', 'research/')}>Browse research <span aria-hidden="true">→</span></a>
    </section>
  </article>
</BaseLayout>
