---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { availability, background, expertise, profile } from '../data/profile';
import { projects } from '../data/projects';
import { localizedPath } from '../i18n';

export const prerender = true;

const research = (await getCollection('research', ({ data }) => !data.draft && data.locale === 'en'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout locale="en" pagePath="">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{profile.eyebrow}</p>
      <h1>{profile.title}</h1>
      <p class="hero-tagline">{profile.tagline}</p>
      <p class="hero-summary">Professional experience across derivatives, digital assets and systematic trading.</p>
      <div class="button-row">
        <a class="button button-primary" href={localizedPath('en', 'projects/')}>View projects</a>
        <a class="button button-secondary" href={localizedPath('en', 'research/')}>Read research</a>
        <a class="button button-secondary" href={localizedPath('en', 'contact/')}>Contact</a>
      </div>
    </div>
    <aside class="hero-index" aria-label="Focus areas">
      <span>01</span><p>Markets</p>
      <span>02</span><p>Quantitative research</p>
      <span>03</span><p>Software</p>
    </aside>
  </section>

  <section class="shell section" aria-labelledby="selected-projects">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2 id="selected-projects">Research projects</h2>
      <a class="text-link" href={localizedPath('en', 'projects/')}>All projects <span aria-hidden="true">→</span></a>
    </div>
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} locale="en" />)}
    </div>
  </section>

  <section class="shell section section-rule" aria-labelledby="expertise">
    <div class="section-heading compact">
      <p class="eyebrow">Capabilities</p>
      <h2 id="expertise">Expertise</h2>
    </div>
    <div class="expertise-grid">
      {expertise.map((area) => (
        <section>
          <h3>{area.title}</h3>
          <ul>{area.items.map((item) => <li>{item}</li>)}</ul>
        </section>
      ))}
    </div>
  </section>

  <section class="shell section section-rule" aria-labelledby="research-notes">
    <div class="section-heading">
      <p class="eyebrow">Writing</p>
      <h2 id="research-notes">Selected research</h2>
      <a class="text-link" href={localizedPath('en', 'research/')}>All research <span aria-hidden="true">→</span></a>
    </div>
    <div class="article-list">
      {research.map((article) => <ArticleCard article={article} locale="en" />)}
    </div>
  </section>

  <section class="shell section section-rule split-section" aria-labelledby="background">
    <div class="section-heading compact">
      <p class="eyebrow">Professional background</p>
      <h2 id="background">Markets experience</h2>
      <p>{profile.summary}</p>
    </div>
    <ol class="timeline">
      {background.map((entry) => (
        <li>
          <p class="timeline-role">{entry.role}</p>
          <p class="timeline-place">{entry.organisation}</p>
          <ul class="tag-list">{entry.topics.map((topic) => <li>{topic}</li>)}</ul>
        </li>
      ))}
    </ol>
  </section>

  <section class="shell section availability-section" aria-labelledby="available-work">
    <div>
      <p class="eyebrow">Selected engagements</p>
      <h2 id="available-work">Available for work</h2>
      <p class="availability-statement">{profile.availability}</p>
      <p>Quantitative research, trading strategy research, market and trading data analysis, digital asset research, derivatives analytics, trading-system prototyping, Python-based financial analysis and market microstructure research.</p>
      <a class="button button-primary" href={localizedPath('en', 'contact/')}>Start a conversation</a>
    </div>
    <div class="engagement-grid">
      {availability.map((item) => (
        <section>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
