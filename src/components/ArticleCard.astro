---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n';
import { localizedPath, ui } from '../i18n';

interface Props {
  article: CollectionEntry<'research'>;
  locale: Locale;
}

const { article, locale } = Astro.props;
const copy = ui[locale];
const href = localizedPath(locale, 'research/' + article.data.route + '/');
const date = article.data.date.toLocaleDateString(locale === 'ja' ? 'ja-JP' : 'en-GB', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
  timeZone: 'UTC',
});
---

<article class="article-card">
  <div class="article-meta">
    <span>{article.data.category}</span>
    <time datetime={article.data.date.toISOString()}>{date}</time>
  </div>
  <h3><a href={href}>{article.data.title}</a></h3>
  <p>{article.data.description}</p>
  <ul class="tag-list" aria-label={copy.articleTags}>
    {article.data.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <a class="text-link" href={href}>{copy.readNote} <span aria-hidden="true">→</span></a>
</article>
