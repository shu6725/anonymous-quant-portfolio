---
import type { Locale } from '../i18n';
import { localizedPath, ui } from '../i18n';

interface Props {
  locale: Locale;
  pagePath?: string;
}

const { locale, pagePath = '' } = Astro.props;
const pathname = Astro.url.pathname;
const copy = ui[locale];
const links = copy.navigation.map((link) => ({ ...link, href: localizedPath(locale, link.path) }));
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a class="wordmark" href={localizedPath(locale)} aria-label={copy.homeLabel}>
      <span class="wordmark-mark" aria-hidden="true">∕∕</span>
      <span>QUANTITATIVE TRADER</span>
    </a>
    <nav aria-label={copy.primaryNavigation}>
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={pathname === link.href || (link.path && pathname.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="language-switcher" aria-label="Language / 言語">
      <a href={localizedPath('en', pagePath)} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
      <span aria-hidden="true">/</span>
      <a href={localizedPath('ja', pagePath)} aria-current={locale === 'ja' ? 'page' : undefined}>JP</a>
    </nav>
  </div>
</header>
