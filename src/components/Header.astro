---
import { internalPath } from '../utils/paths';

const pathname = Astro.url.pathname;
const links = [
  { href: internalPath(), label: 'Home' },
  { href: internalPath('about/'), label: 'About' },
  { href: internalPath('research/'), label: 'Research' },
  { href: internalPath('projects/'), label: 'Projects' },
  { href: internalPath('contact/'), label: 'Contact' },
];
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a class="wordmark" href={internalPath()} aria-label="Quantitative Trader home">
      <span class="wordmark-mark" aria-hidden="true">∕∕</span>
      <span>QUANTITATIVE TRADER</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
