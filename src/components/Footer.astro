---
import type { Locale } from '../i18n';
import { ui } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <p>{copy.footerPortfolio}</p>
    <p>{copy.footerDisclaimer}</p>
  </div>
</footer>
