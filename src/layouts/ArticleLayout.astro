---
import BaseLayout from './BaseLayout.astro';
import { internalPath } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  category: string;
  date: Date;
  tags: string[];
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { title, description, category, date, tags, headings = [] } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const tableOfContents = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

<BaseLayout title={title} description={description}>
  <article class="article-shell shell reading-width">
    <a class="back-link" href={internalPath('research/')}>← All research</a>
    <header class="article-header">
      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <p class="article-dek">{description}</p>
      <div class="article-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>Independent research note</span>
      </div>
      <ul class="tag-list" aria-label="Article tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>
    {tableOfContents.length > 0 && (
      <nav class="article-toc" aria-label="On this page">
        <p>On this page</p>
        <ol>
          {tableOfContents.map((heading) => (
            <li class:list={{ 'toc-subitem': heading.depth === 3 }}>
              <a href={'#' + heading.slug}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
