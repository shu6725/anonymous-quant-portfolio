---
import BaseLayout from './BaseLayout.astro';
import { internalPath } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  category: string;
  date: Date;
  tags: string[];
}

const { title, description, category, date, tags } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={description}>
  <article class="article-shell shell reading-width">
    <a class="back-link" href={internalPath('research/')}>← All research</a>
    <header class="article-header">
      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <p class="article-dek">{description}</p>
      <div class="article-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>Independent research note</span>
      </div>
      <ul class="tag-list" aria-label="Article tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
