---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n';
import { ui } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  pagePath?: string;
}

const {
  title = 'Quantitative Trader',
  description = 'Anonymous professional portfolio for financial-markets research and software work.',
  locale = 'en',
  pagePath = '',
} = Astro.props;
const copy = ui[locale];
const pageTitle = title === 'Quantitative Trader' ? title : `${title} — Quantitative Trader`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipToContent}</a>
    <Header locale={locale} pagePath={pagePath} />
    <main id="main-content"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
